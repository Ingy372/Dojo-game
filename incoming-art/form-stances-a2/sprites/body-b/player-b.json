  "optionNotes": {
    "face-01": "the approved face of Batch 1: oval eyes with a shine, friendly brows, a small smile",
    "face-02": "big round eyes, soft high brows, a wider smile",
    "face-03": "calm almond eyes, straight brows, a small smile",
    "face-04": "oval eyes with small lashes at the outer corner, a happy smile",
    "face-05": "bold thick brows, determined but friendly",
    "face-06": "oval eyes and freckles across the cheeks",
    "hair-01": "very short (close crop): a thin cap that follows the head",
    "hair-02": "short: the approved Batch 1 hair (cap, back, sideburns, a short fringe and a tuft)",
    "hair-03": "curly: a rounder cap made of soft curls",
    "hair-04": "afro: a rounded shape built from soft coil clumps with light tops, a natural hairline above the brows",
    "hair-05": "braids: a smooth cap with two braids hanging behind the ears to the shoulders",
    "hair-06": "ponytail: cap pulled back to a tie at the back of the head, a short tail (above the belt)",
    "hair-07": "bun: cap with a round bun on top towards the back",
    "hair-08": "tied back: smooth hair combed back to a low knot at the nape",
    "hair-09": "two puffs: hair parted down the middle and gathered into two round coil puffs high on the head",
    "hair-10": "short twists: a soft cap covered in short, rounded twists that point up and out (they never reach the eyes)",
    "hair-11": "cornrows into braids: neat raised rows from the hairline to the back, ending in braids that hang behind the shoulders",
    "hair-12": "high-top fade: short faded sides and a tall rounded flat-top of tight coils"
  }
