  "scenes": [
    {
      "id": "intro",
      "kind": "story",
      "lines": [
        {
          "speaker": "narrator",
          "text": "{player} is at the store with {grownup}."
        },
        {
          "speaker": "narrator",
          "text": "{player} stops to look at the toys."
        },
        {
          "speaker": "narrator",
          "text": "When {player} looks up, {grownup} is gone."
        },
        {
          "speaker": "player",
          "text": "Where did {grownup} go?",
          "expression": "thinking"
        },
        {
          "speaker": "sensei",
          "text": "Take a big breath, {player}.",
          "expression": "neutral",
          "animation": "nod"
        },
        {
          "speaker": "sensei",
          "text": "You know what to do.",
          "expression": "happy"
        }
      ]
    },
    {
      "id": "stay",
      "kind": "choice",
      "lines": [
        {
          "id": "choice-stay",
          "speaker": "narrator",
          "text": "What do you do first?",
          "choices": [
            {
              "text": "Stay right here.",
              "stars": 1,
              "next": "stay-good"
            },
            {
              "text": "Run and look everywhere.",
              "stars": 0,
              "next": "stay-retry"
            },
            {
              "text": "Go outside to look.",
              "stars": 0,
              "next": "outside-retry"
            }
          ]
        }
      ],
      "branches": {
        "stay-good": [
          {
            "speaker": "sensei",
            "text": "Good. Staying close helps {grownup} find you.",
            "expression": "proud",
            "animation": "nod"
          }
        ],
        "stay-retry": [
          {
            "speaker": "sensei",
            "text": "Let's see what could have gone differently.",
            "expression": "thinking"
          },
          {
            "speaker": "sensei",
            "text": "If you both keep moving, can you find each other?",
            "expression": "thinking"
          },
          {
            "speaker": "narrator",
            "text": "Let's try again.",
            "retry": "choice-stay"
          }
        ],
        "outside-retry": [
          {
            "speaker": "sensei",
            "text": "Let's see what could have gone differently.",
            "expression": "thinking"
          },
          {
            "speaker": "sensei",
            "text": "Where is {grownup} most likely to be?",
            "expression": "thinking"
          },
          {
            "speaker": "narrator",
            "text": "Let's try again.",
            "retry": "choice-stay"
          }
        ]
