            "text": "Who are you here with?",
            "expression": "happy"
          },
          {
            "speaker": "player",
            "text": "I'm here with my {grownup}.",
            "expression": "neutral"
          },
          {
            "speaker": "worker",
            "text": "Let's stay here together.",
            "expression": "happy"
          },
          {
            "speaker": "narrator",
            "text": "The worker calls on the store speaker."
          }
        ],
        "voice-retry": [
          {
            "speaker": "sensei",
            "text": "Let's see what could have gone differently.",
