{
  "notes": "Street Smarts scenario 'Separated from your grown-up in a store'. Round 2 script approved by Jay on Nov 24 (docs/superpowers/specs/2026-11-24-street-smarts-cutscene-design.md); played as a cut scene in the Blender store (room: content/street-smarts/store-room.json). 'stage' lists the cut-scene moves for a line, played in order (a cue with \"with\": true runs alongside the one before); the words show and are read when the line starts, or after the moves when \"say\" is \"after\". A 'tap' choice is answered by tapping a person or place in the store ('target'). A retry branch never moves anyone, so a not-best answer is never acted out. starChoices earn a star on a best first try; voice is required to continue but earns none.",
  "id": "store-separated",
  "location": "store",
  "room": "store",
  "ageBand": "6-9",
  "topic": "Separated from your grown-up in a store",
  "priorities": ["awareness", "get-help"],
  "characters": [
    { "id": "sensei", "role": "Sensei", "name": null, "title": "Sensei", "note": "Not in the store: his portrait slides in at the corner with a chime, and he has his own voice." },
    { "id": "grownup", "role": "Player's grown-up", "name": null, "title": null, "note": "Mom or Dad (the player's pick). Relieved and smiling at the end, never angry." },
    { "id": "worker", "role": "Store worker", "name": null, "title": null, "note": "Blue store vest and a name tag. Calm and kind." },
    { "id": "cashier", "role": "Cashier", "name": null, "title": null, "note": "Blue store vest and a name tag, behind the counter." },
    { "id": "stranger", "role": "Stranger", "name": null, "title": null, "note": "An ordinary shopper in an aisle. Never shown as scary; does nothing." },
    { "id": "shopper", "role": "Shopper", "name": null, "title": null, "note": "Ordinary adult. Not shown as scary or mean. Never grabs or follows." }
  ],
  "scenes": [
    {
      "id": "intro",
      "kind": "story",
      "lines": [
        {
          "speaker": "narrator",
          "text": "{player} is at the store with {grownup}.",
          "stage": [
            { "do": "place", "who": "worker", "to": "worker", "dir": "W" },
            { "do": "place", "who": "cashier", "to": "cashier", "dir": "S", "with": true },
            { "do": "place", "who": "stranger", "to": "stranger", "dir": "N", "with": true },
            { "do": "place", "who": "player", "to": "enter-player", "dir": "N", "with": true },
            { "do": "place", "who": "grownup", "to": "enter-grownup", "dir": "N", "with": true },
            { "do": "camera", "fit": ["toy-player", "enter-player"], "with": true },
            { "do": "walk", "who": "grownup", "to": "toy-grownup", "via": ["east-aisle-grownup"] },
            { "do": "walk", "who": "player", "to": "toy-player", "via": ["east-aisle"], "with": true },
            { "do": "camera", "fit": ["toy-player", "toy-grownup"] },
            { "do": "face", "who": "player", "dir": "N" },
            { "do": "emote", "who": "player", "emote": "toy" },
            { "do": "walk", "who": "grownup", "to": "grownup-away", "with": true },
            { "do": "hide", "who": "grownup" }
          ]
        },
        {
          "speaker": "narrator",
          "text": "When {player} looks up, {grownup} is gone.",
          "stage": [
            { "do": "face", "who": "player", "dir": "S" },
            { "do": "emote", "who": "player", "emote": "question" }
          ]
        },
        { "speaker": "sensei", "text": "Take a big breath. You know what to do.", "expression": "neutral" }
      ]
    },
    {
      "id": "first",
      "kind": "choice",
      "lines": [
        {
          "id": "choice-first",
          "speaker": "narrator",
          "text": "What do you do first?",
          "choices": [
            { "text": "Go to the front and find someone who can help me.", "stars": 1, "next": "first-good" },
            { "text": "Run and look everywhere.", "stars": 0, "next": "run-retry" },
            { "text": "Go outside to look.", "stars": 0, "next": "outside-retry" }
          ]
        }
      ],
      "branches": {
        "first-good": [
          {
            "speaker": "sensei",
            "text": "Good. The front is where the helpers are.",
            "expression": "proud",
            "stage": [
              { "do": "walk", "who": "player", "to": "front-player", "via": ["middle-aisle-back", "middle-aisle-front"] },
              { "do": "camera", "fit": ["hide-spot", "cashier", "stranger"], "with": true },
              { "do": "face", "who": "player", "dir": "S" }
            ]
          }
        ],
        "run-retry": [
          { "speaker": "sensei", "text": "If you both keep moving, can you find each other?", "expression": "thinking", "retry": "choice-first" }
        ],
        "outside-retry": [
          { "speaker": "sensei", "text": "Where is {grownup} most likely to be?", "expression": "thinking", "retry": "choice-first" }
        ]
      }
    },
    {
      "id": "helper",
      "kind": "get-help",
      "lines": [
        {
          "id": "choice-helper",
          "speaker": "narrator",
          "text": "Who can help? Tap them.",
          "tap": true,
          "choices": [
            { "text": "The store worker", "target": "worker", "stars": 1, "next": "worker-good" },
            { "text": "The cashier", "target": "cashier", "stars": 1, "next": "cashier-good" },
            { "text": "A stranger", "target": "stranger", "stars": 0, "next": "stranger-retry" },
            { "text": "Hide behind the boxes", "target": "hide-spot", "stars": 0, "next": "hide-retry" }
          ],
          "note": "Safe helpers (J11, Jay Nov 24): someone who works at the store, in the blue vest with a name tag. Grown-ups with kids are no longer a right answer (Jay: they shouldn't automatically be trusted). The worker is the helper the story continues with."
        }
      ],
      "branches": {
        "worker-good": [
          {
            "speaker": "sensei",
            "text": "Yes! That's a safe helper.",
            "expression": "proud",
            "stage": [
              { "do": "camera", "fit": ["meet-worker", "front-player"] },
              { "do": "walk", "who": "worker", "to": "meet-worker", "with": true },
              { "do": "face", "who": "worker", "dir": "E" },
              { "do": "face", "who": "player", "dir": "W", "with": true }
            ]
          }
        ],
        "cashier-good": [
          {
            "speaker": "sensei",
            "text": "Yes! That's a safe helper.",
            "expression": "proud",
            "stage": [
              { "do": "anim", "who": "cashier", "anim": "wave" },
              { "do": "camera", "fit": ["meet-worker", "front-player"] },
              { "do": "walk", "who": "worker", "to": "meet-worker", "with": true },
              { "do": "face", "who": "worker", "dir": "E" },
              { "do": "face", "who": "player", "dir": "W", "with": true }
            ]
          }
        ],
        "stranger-retry": [
          { "speaker": "sensei", "text": "You don't know if a stranger is safe.", "expression": "thinking" },
          { "speaker": "sensei", "text": "Look for someone who works here.", "expression": "thinking", "retry": "choice-helper" }
        ],
        "hide-retry": [
          { "speaker": "sensei", "text": "If you hide, who will know you need help?", "expression": "thinking", "retry": "choice-helper" }
        ]
      }
    },
    {
      "id": "voice",
      "kind": "voice",
      "lines": [
        { "speaker": "worker", "text": "Hi there. Are you okay?", "expression": "happy" },
        {
          "id": "choice-voice",
          "speaker": "narrator",
          "text": "What do you tell the worker?",
          "choices": [
            { "text": "I can't find {grownup}. Can you help me?", "stars": 1, "next": "voice-good" },
            { "text": "Say nothing. The worker looks kinda scary.", "stars": 0, "next": "voice-retry" }
          ]
        }
      ],
      "branches": {
        "voice-good": [
          {
            "speaker": "worker",
            "text": "I'll call {grownup} on the store speaker.",
            "expression": "happy",
            "stage": [
              { "do": "pause", "secs": 1.2 },
              { "do": "emote", "to": "speaker", "emote": "sound" }
            ]
          },
          { "speaker": "worker", "text": "Let's wait here together.", "expression": "happy" }
        ],
        "voice-retry": [
          { "speaker": "sensei", "text": "It's okay to feel shy.", "expression": "thinking" },
          { "speaker": "sensei", "text": "Helpers can only help when they know what's wrong.", "expression": "thinking", "retry": "choice-voice" }
        ]
      }
    },
    {
      "id": "offer",
      "kind": "choice",
      "lines": [
        {
          "speaker": "shopper",
          "text": "{grownup} is waiting outside. Come with me!",
          "expression": "neutral",
          "say": "after",
          "stage": [
            { "do": "place", "who": "shopper", "to": "door-out", "dir": "N" },
            { "do": "camera", "fit": ["meet-worker", "shopper-talk", "door-in"], "with": true },
            { "do": "walk", "who": "shopper", "to": "shopper-talk", "via": ["door-in"] },
            { "do": "face", "who": "shopper", "dir": "W" },
            { "do": "face", "who": "player", "dir": "E", "with": true }
          ]
        },
        { "speaker": "narrator", "text": "{player} doesn't know this person. They didn't say your family's secret word." },
        {
          "id": "choice-offer",
          "speaker": "narrator",
          "text": "What do you do?",
          "choices": [
            { "text": "No thank you! I'm staying with the worker.", "stars": 1, "next": "offer-good" },
            { "text": "Go with them.", "stars": 0, "next": "offer-retry" }
          ]
        }
      ],
      "branches": {
        "offer-good": [
          {
            "speaker": "worker",
            "text": "Good thinking. We'll wait right here.",
            "expression": "happy",
            "stage": [
              { "do": "walk", "who": "shopper", "to": "door-out", "via": ["door-in"] },
              { "do": "hide", "who": "shopper" },
              { "do": "face", "who": "player", "dir": "W", "with": true }
            ]
          },
          { "speaker": "sensei", "text": "Strong choice, {player}.", "expression": "proud" }
        ],
        "offer-retry": [
          { "speaker": "sensei", "text": "Only a safe grown-up knows your family's secret word.", "expression": "neutral" },
          { "speaker": "sensei", "text": "Stay with your helper.", "expression": "neutral", "retry": "choice-offer" }
        ]
      }
    },
    {
      "id": "reunion",
      "kind": "story",
      "lines": [
        {
          "speaker": "grownup",
          "text": "There you are! I'm so glad you followed what we practiced.",
          "expression": "happy",
          "say": "after",
          "stage": [
            { "do": "place", "who": "grownup", "to": "door-out", "dir": "N" },
            { "do": "walk", "who": "grownup", "to": "hug-grownup", "via": ["door-in"], "speed": "hurry" },
            { "do": "face", "who": "grownup", "dir": "W" },
            { "do": "face", "who": "player", "dir": "E", "with": true },
            { "do": "emote", "who": "player", "emote": "hearts" },
            { "do": "emote", "who": "grownup", "emote": "hearts", "with": true }
          ]
        }
      ]
    },
    {
      "id": "sensei-reflect",
      "kind": "reflection",
      "lines": [
        { "speaker": "sensei", "text": "You put into practice what you have learned and used your voice.", "expression": "proud" },
        { "speaker": "sensei", "text": "That's what got you home safe and sound!", "expression": "happy", "animation": "bow" }
      ]
    }
  ],
  "stars": {
    "max": 3,
    "rule": "Best choices on the first try at first, helper, and offer earn 1 star each (voice is required to continue). A retry still finishes the scenario and can be replayed for all 3 stars.",
    "note": "Per decisions.md, Street Smarts power is 0."
  },
  "starChoices": ["choice-first", "choice-helper", "choice-offer"]
}
