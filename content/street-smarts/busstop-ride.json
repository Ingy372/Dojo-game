{
  "notes": "Street Smarts lesson 3, 'A ride from the bus stop'. Script approved by Jay on Nov 24 (docs/superpowers/specs/2026-11-24-street-smarts-lessons-2-5-design.md); played as a cut scene at the Blender bus stop (room: content/street-smarts/busstop-room.json). The car is a cast prop; the driver only speaks from it and never gets out. A retry branch never moves anyone.",
  "id": "busstop-ride",
  "location": "bus stop",
  "room": "busstop",
  "ageBand": "10-13",
  "topic": "A ride from the bus stop",
  "priorities": ["awareness", "avoidance", "get-help"],
  "characters": [
    { "id": "sensei", "role": "Sensei", "name": null, "title": "Sensei", "note": "His portrait rises at the corner with a chime." },
    { "id": "guard", "role": "Crossing guard", "name": null, "title": null, "note": "Bright orange safety vest, by the crosswalk. Kind and calm." },
    { "id": "kid1", "role": "Kid waiting", "name": null, "title": null, "note": "A kid waiting for the bus." },
    { "id": "kid2", "role": "Kid waiting", "name": null, "title": null, "note": "A kid waiting for the bus." },
    { "id": "car", "role": "The car", "name": null, "title": null, "note": "An ordinary blue car. Pulls up, waits, drives away. Never chases." },
    { "id": "driver", "role": "Driver", "name": null, "title": null, "note": "Only a voice from the car. Never gets out, never grabs." }
  ],
  "scenes": [
    {
      "id": "intro",
      "kind": "story",
      "lines": [
        {
          "speaker": "narrator",
          "text": "{player} waits at the bus stop after school.",
          "stage": [
            { "do": "place", "who": "guard", "to": "guard", "dir": "S" },
            { "do": "place", "who": "kid1", "to": "kid1", "dir": "SE", "with": true },
            { "do": "place", "who": "kid2", "to": "kid2", "dir": "W", "with": true },
            { "do": "place", "who": "player", "to": "player-start", "dir": "S", "with": true },
            { "do": "camera", "fit": ["player-start", "guard", "trees", "shelter-back"], "with": true }
          ]
        },
        {
          "speaker": "narrator",
          "text": "The bus is late today.",
          "stage": [{ "do": "emote", "who": "player", "emote": "question" }]
        }
      ]
    },
    {
      "id": "spot",
      "kind": "awareness",
      "lines": [
        {
          "id": "choice-spot",
          "speaker": "narrator",
          "text": "Where's the safest place to wait? Tap it.",
          "tap": true,
          "choices": [
            { "text": "By the guard and kids", "target": "safe-wait", "stars": 1, "next": "spot-good" },
            { "text": "Behind the bus shelter", "target": "shelter-back", "stars": 0, "next": "shelter-retry" },
            { "text": "By the trees", "target": "trees", "stars": 0, "next": "trees-retry" }
          ]
        }
      ],
      "branches": {
        "spot-good": [
          {
            "speaker": "sensei",
            "text": "Good spot. People can see you here.",
            "expression": "proud",
            "stage": [
              { "do": "walk", "who": "player", "to": "safe-wait" },
              { "do": "face", "who": "player", "dir": "S" }
            ]
          }
        ],
        "shelter-retry": [
          { "speaker": "sensei", "text": "If you need help, who can see you there?", "expression": "thinking", "retry": "choice-spot" }
        ],
        "trees-retry": [
          { "speaker": "sensei", "text": "Out of sight means no one can help.", "expression": "thinking", "retry": "choice-spot" }
        ]
      }
    },
    {
      "id": "ride",
      "kind": "choice",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A car pulls up to the curb.",
          "stage": [
            { "do": "place", "who": "car", "to": "car-in" },
            { "do": "camera", "fit": ["safe-wait", "guard", "car-stop", "kid2"], "with": true },
            { "do": "walk", "who": "car", "to": "car-stop", "speed": "hurry" }
          ]
        },
        { "speaker": "driver", "text": "Hey! {grownup} asked me to pick you up.", "expression": "happy" },
        { "speaker": "narrator", "text": "{player} doesn't know this driver." },
        { "speaker": "narrator", "text": "They didn't say your secret word." },
        {
          "id": "choice-ride",
          "speaker": "narrator",
          "text": "What do you do?",
          "choices": [
            { "text": "Step back and say, \"No thanks.\"", "stars": 1, "next": "ride-good" },
            { "text": "Walk to the car window to talk.", "stars": 0, "next": "window-retry" },
            { "text": "Get in. They know {grownup}'s name.", "stars": 0, "next": "getin-retry" }
          ]
        }
      ],
      "branches": {
        "ride-good": [
          {
            "speaker": "narrator",
            "text": "{player} steps back from the car.",
            "stage": [
              { "do": "emote", "who": "player", "emote": "shout", "text": "No thanks." },
              { "do": "walk", "who": "player", "to": "step-back" },
              { "do": "face", "who": "player", "dir": "S" }
            ]
          }
        ],
        "window-retry": [
          { "speaker": "sensei", "text": "How close do you need to be to answer?", "expression": "thinking", "retry": "choice-ride" }
        ],
        "getin-retry": [
          { "speaker": "sensei", "text": "Anyone can learn a name.", "expression": "thinking" },
          { "speaker": "sensei", "text": "Only safe grown-ups know your secret word.", "expression": "thinking", "retry": "choice-ride" }
        ]
      }
    },
    {
      "id": "voice",
      "kind": "voice",
      "lines": [
        { "speaker": "driver", "text": "Come on, it's fine. Hop in.", "expression": "neutral" },
        {
          "id": "choice-voice",
          "speaker": "narrator",
          "text": "The driver keeps asking. What now?",
          "choices": [
            { "text": "Yell \"NO! I don't know you!\" and go to the guard.", "stars": 1, "next": "voice-good" },
            { "text": "Say nothing and wait.", "stars": 0, "next": "voice-retry" }
          ]
        }
      ],
      "branches": {
        "voice-good": [
          {
            "speaker": "narrator",
            "text": "The car drives away.",
            "say": "after",
            "stage": [
              { "do": "emote", "who": "player", "emote": "shout", "text": "NO! I don't know you!" },
              { "do": "walk", "who": "player", "to": "by-guard", "speed": "hurry" },
              { "do": "walk", "who": "car", "to": "car-out", "speed": "hurry", "with": true },
              { "do": "hide", "who": "car" }
            ]
          }
        ],
        "voice-retry": [
          { "speaker": "sensei", "text": "A loud voice makes people look, and that brings help.", "expression": "thinking", "retry": "choice-voice" }
        ]
      }
    },
    {
      "id": "tell",
      "kind": "get-help",
      "lines": [
        {
          "speaker": "guard",
          "text": "I heard you. Are you okay?",
          "expression": "happy",
          "stage": [
            { "do": "camera", "fit": ["by-guard", "guard", "kid1"] },
            { "do": "face", "who": "guard", "dir": "NE", "with": true },
            { "do": "face", "who": "player", "dir": "SW", "with": true }
          ]
        },
        { "speaker": "player", "text": "A driver I don't know wanted me to get in.", "expression": "neutral" },
        { "speaker": "guard", "text": "Thank you for telling me.", "expression": "happy" },
        { "speaker": "guard", "text": "I'll call your school and {grownup}.", "expression": "happy" }
      ]
    },
    {
      "id": "sensei-reflect",
      "kind": "reflection",
      "lines": [
        { "speaker": "sensei", "text": "You waited where people could see you.", "expression": "proud" },
        { "speaker": "sensei", "text": "You kept your distance and used your voice. Great awareness!", "expression": "happy", "animation": "bow" }
      ]
    }
  ],
  "stars": { "max": 3, "rule": "Best choices on the first try at spot, ride and voice earn 1 star each.", "note": "Street Smarts power is 0." },
  "starChoices": ["choice-spot", "choice-ride", "choice-voice"]
}
